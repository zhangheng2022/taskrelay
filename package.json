{
  "name": "taskrelay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @taskrelay/web",
    "desktop": "npm run start -w @taskrelay/desktop",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:ui": "node --import tsx --test tests/*.test.tsx",
    "build": "npm run build -w @taskrelay/web",
    "db:migrate": "npm run db:migrate -w @taskrelay/web",
    "prepare:browser": "node scripts/prepare-browser.mjs",
    "package": "npm run package -w @taskrelay/desktop",
    "make": "npm run make -w @taskrelay/desktop",
    "test:smoke": "node scripts/smoke.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "icons": "node scripts/icon.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.15",
    "@browserbasehq/stagehand": "4.3.0",
    "@langchain/core": "1.3.4",
    "@langchain/langgraph": "1.6.0",
    "@langchain/langgraph-checkpoint": "1.2.2",
    "better-auth": "1.7.15",
    "cron-parser": "^5.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.10.0",
    "ipaddr.js": "^2.2.0",
    "jose": "^6.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@hono/cli": "^1.0.0-rc.8",
    "@puppeteer/browsers": "latest",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "latest",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "latest",
    "class-variance-authority": "0.7.1",
    "clsx": "latest",
    "electron": "45.2.1",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "lucide-react": "latest",
    "miniflare": "5.20261101.0-beta",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "latest",
    "tailwindcss": "4.3.3",
    "tsx": "latest",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wrangler": "latest"
  },
  "overrides": {
    "zod": "$zod"
  }
}
