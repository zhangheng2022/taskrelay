{
  "name": "taskrelay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @taskrelay/web",
    "desktop": "npm run start -w @taskrelay/desktop",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:ui": "node --import tsx --test tests/*.test.tsx",
    "build": "npm run build -w @taskrelay/web",
    "db:migrate": "npm run db:migrate -w @taskrelay/web",
    "prepare:browser": "node scripts/prepare-browser.mjs",
    "package": "npm run package -w @taskrelay/desktop",
    "make": "npm run make -w @taskrelay/desktop",
    "test:smoke": "node scripts/smoke.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "icons": "node scripts/icon.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.18",
    "@browserbasehq/stagehand": "4.4.0",
    "@langchain/core": "1.3.5",
    "@langchain/langgraph": "1.7.1",
    "@langchain/langgraph-checkpoint": "1.2.2",
    "better-auth": "1.7.18",
    "cron-parser": "5.10.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.15",
    "zod": "4.6.7",
    "langchain": "1.6.2",
    "p-limit": "7.3.3",
    "openai": "7.52.0",
    "chrome-remote-interface": "0.34.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261106.1",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@hono/cli": "1.0.0-rc.9",
    "@puppeteer/browsers": "3.2.6",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "45.2.3",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "lucide-react": "1.70.0",
    "miniflare": "5.20261104.0-beta",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "wrangler": "4.158.0",
    "@types/chrome-remote-interface": "0.34.1"
  },
  "overrides": {
    "zod": "$zod"
  }
}
